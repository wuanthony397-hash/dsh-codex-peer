    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "license": "MIT",
  "author": "Anthony Wu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuanthony397-hash/dsh-codex-peer.git"
  },
  "homepage": "https://github.com/wuanthony397-hash/dsh-codex-peer#readme",
  "bugs": {
    "url": "https://github.com/wuanthony397-hash/dsh-codex-peer/issues"
  },
